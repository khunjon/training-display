{
  "calendar_id": "xxxxxxxxxxxxxxxx@group.calendar.google.com",
  "service_account_key": "~/.config/training-display/sa.json",
  "timezone": "Asia/Bangkok",

  "people": [
    {
      "name": "Alex",
      "emails": ["alex@example.com"],
      "activity_log": "~/vault/health/Exercise/activity_log.csv"
    },
    {
      "name": "Sam",
      "emails": ["sam@example.com"]
    }
  ],

  "together_window_min": 30,
  "battery_low_v": 3.6,

  "goals_dir": "~/vault/health/Goals",
  "quotes_file": "~/vault/ai/Projects/Training Display Quotes.md",

  "special_days": [
    {"date": "09-22", "text": "Happy {nth} anniversary, Alex & Sam", "since": 2024, "icon": "heart"},
    {"date": "09-07", "text": "Happy birthday, Sam!", "icon": "cake"},
    {"date": "12-19", "text": "Happy birthday, Alex!", "icon": "cake"}
  ],

  "fonts_dir": "~/.local/state/training-display/fonts",
  "output_dir": "~/.local/state/training-display",

  "server": {
    "bind": "0.0.0.0",
    "port": 8787,
    "refresh_rate": 3600,
    "quiet": {"from": "23:00", "until": "06:10"},
    "friendly_id": "training-display"
  }
}
